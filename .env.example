# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys. `zebra` (src/cli/main.ts) auto-loads .env if
# present; a real shell `export` still takes precedence over whatever's in this file.

# Required for `zebra extract` (ADR-004) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for SPIKE-016 (design/spikes/SPIKE-016-typesafe-jev-evaluation/) — TypeSafe's Jev
# System-One judgment model, evaluated as a candidate replacement for a handful of
# classification/verification steps. Third-party, unrelated to OpenRouter. Get a key at
# https://typesafe.ai. Spike-only: never referenced by src/ production code.
TYPESAFE_API_KEY=

# Optional: override the default model tiers `zebra extract` uses (ADR-003 §2.6, ADR-004 §2.5).
# Precedence: --model/--frontier-model flag > these env vars > built-in defaults shown below.
# ZEBRA_MODEL=openai/gpt-4o-mini
# ZEBRA_FRONTIER_MODEL=anthropic/claude-sonnet-4.5

# Optional: route extraction through a local OpenAI-compatible server (LM Studio, Ollama-style)
# instead of OpenRouter. The server's own model ids apply (from its /v1/models) — e.g. with
# LM Studio serving Qwen3: ZEBRA_LOCAL_BASE_URL=http://localhost:1234/v1 with
# ZEBRA_MODEL=qwen/qwen3.8-27b. No API key needed (a dummy value is sent; local servers ignore
# auth). Local inference is far slower: raise the per-call timeout (ms) to match.
# ZEBRA_LOCAL_BASE_URL=http://localhost:1234/v1
# ZEBRA_LOCAL_TIMEOUT_MS=600000

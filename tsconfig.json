{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    // "module": "nodenext",
    // "target": "esnext",
    // "types": [],
    // For nodejs:
    // "lib": ["nodenext"],
    "types": ["node"],
    "target": "ES2022",
    "module": "NodeNext",
    "allowJs": false,
    "rewriteRelativeImportExtensions": true, // Rewrite `.ts` imports to `.js` at build time.
    "erasableSyntaxOnly": true, // Allows to run directly with node and type removal

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  // No "include" — tsc's default is every reachable .ts file under the project root — so a
  // nested spike worktree (a full duplicate checkout, its own tsconfig.json included) and a
  // spike's own scoped-package.json scripts (deliberately depending on packages not installed
  // at the root, e.g. SPIKE-007's effect@rc.112/@effect/ai-openrouter — see that spike's
  // package.json and design/spikes/SPIKE-002-*'s precedent) both need excluding explicitly,
  // or `tsc --noEmit` fails on dependencies this project was never meant to have.
  "exclude": ["node_modules", "design/spikes/*/worktree/**", "design/spikes/*/scripts/**"]
}
